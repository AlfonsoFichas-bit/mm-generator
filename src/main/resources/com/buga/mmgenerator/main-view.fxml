<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootContainer" styleClass="window-container" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.buga.mmgenerator.MainController">
    <children>
        <BorderPane fx:id="mainLayout">
            <!-- Header Bar (GTK Adwaita style) -->
            <top>
                <HBox fx:id="headerBar" styleClass="header-bar" spacing="10.0">
                    <children>
                        <!-- Left: Search Box -->
                        <HBox fx:id="searchContainer" styleClass="search-container" spacing="6.0" prefWidth="220.0" minWidth="220.0" maxWidth="220.0">
                            <children>
                                <StackPane fx:id="searchIconContainer" />
                                <TextField fx:id="searchField" styleClass="search-field" promptText="Buscar plantillas (ej: troll, doge, ob..." HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- Center: Title -->
                        <Label fx:id="lblTitle" styleClass="header-title" text="Creador de Memes" />

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- Right: Actions and Window Controls -->
                        <HBox fx:id="headerActions" alignment="CENTER_RIGHT" spacing="12.0">
                            <children>
                                <Button fx:id="btnFolder" styleClass="header-button">
                                    <graphic>
                                        <StackPane fx:id="folderIconContainer" />
                                    </graphic>
                                </Button>

                                <HBox alignment="CENTER" spacing="6.0">
                                    <children>
                                        <Button fx:id="btnMinimize" styleClass="win-btn">
                                            <graphic>
                                                <StackPane fx:id="minimizeIconContainer" />
                                            </graphic>
                                        </Button>
                                        <Button fx:id="btnMaximize" styleClass="win-btn">
                                            <graphic>
                                                <StackPane fx:id="maximizeIconContainer" />
                                            </graphic>
                                        </Button>
                                        <Button fx:id="btnClose" styleClass="win-btn, win-btn-close">
                                            <graphic>
                                                <StackPane fx:id="closeIconContainer" />
                                            </graphic>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </top>

            <!-- Left: Sidebar with Categories -->
            <left>
                <VBox fx:id="sidebar" styleClass="sidebar" prefWidth="236.0" minWidth="236.0" maxWidth="236.0" spacing="3.0">
                    <!-- Category buttons added dynamically in controller -->
                </VBox>
            </left>

            <!-- Center: Gallery Flow -->
            <center>
                <ScrollPane fx:id="galleryScroll" fitToWidth="true" styleClass="gallery-scroll" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                    <content>
                        <FlowPane fx:id="galleryFlow" styleClass="gallery-flow" hgap="16.0" vgap="16.0" />
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
    </children>
</StackPane>
